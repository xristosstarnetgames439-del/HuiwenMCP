/node_modules
/oh_modules
/local.properties
# 本地项目开发记录，不进入 Git。
/docs/项目开发记录/
# 本机签名配置由安全模板复制生成，不进入 Git。
/build-profile.json5
# 鸿蒙端原生库由源码构建，保留本机旧 Qt 运行库但不推送。
/entry/libs/
# 项目内 Qt 开发依赖及 PDFium 构建工具/缓存，由准备脚本生成。
/third_party/qt/bin/
/third_party/qt/include/
/third_party/qt/lib/
/third_party/qt/mkspecs/
/third_party/qt/plugins/
/third_party/qt/sdk.json
# 通达迁入的 CEF 环境是本地依赖；版本清单、说明和准备脚本进入 Git。
/third_party/cef/sdk/
# Markdown 发布包和官方源码快照在本机准备，Git 保存版本锁及说明。
/third_party/markdown/node_modules/
/third_party/markdown/sources/
# Markdown Web 资源每次 Run 生成，随 HAP 分发，不进入 Git。
/entry/src/main/resources/rawfile/markdown/
# Python 业务 pyz 由源码生成，随 HAP 分发，不进入 Git。
/entry/src/main/resources/rawfile/python/
# CEF 核心数据由项目内 SDK 同步，保持唯一来源。
/entry/src/main/resources/resfile/
/.native-tools/
/third_party/.gclient*
/third_party/.cipd/
/third_party/.gcs_entries
/third_party/_bad_scm/
/entry/src/main/resources/rawfile/third_party_licenses/
# Python HNP 是本机打包产物；仓库只保存打包脚本和自检源码。
/hnp/**/*.hnp
/.hnp-cache/
# Python 本机语法检查缓存。
__pycache__/
*.pyc
# 覆盖本机全局忽略规则，保留鸿蒙打包脚本源码。
!/packaging/ohos/
/.idea
**/build
/.hvigor
.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer
