{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // Qt 平台初始化与独立工作区 Ability；首页仍为 ArkTS。
    "srcEntry": "./ets/abilitystage/QtAbilityStage.ets",
    "deviceTypes": [
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // CEF 网络服务初始化及网络状态查询使用；页面仍遵守离线资源和导航限制。
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      // 首页窗口容器透明，让半透明侧栏显示桌面或后方窗口。
      { "name": "ohos.permission.SET_WINDOW_TRANSPARENT" },
      // 首页请求用户授权，独立 Qt 截图窗口负责抓屏。
      {
        "name": "ohos.permission.CUSTOM_SCREEN_CAPTURE",
        "reason": "$string:screenshot_permission_reason",
        "usedScene": { "abilities": ["EntryAbility", "QtScreenshotAbility"], "when": "inuse" }
      }
    ],
    // 随 entry HAP 安装的私有 Python 运行时，仅供本应用调用。
    "hnpPackages": [
      {
        "package": "huiwen_python.hnp",
        "type": "private"
      },
      {
        "package": "huiwen_doc2docx.hnp",
        "type": "private"
      }
    ],
    // 首页与文档工作区使用应用图标；截图宿主使用透明启动页。
    "abilities": [
      {
        "name": "QtScreenshotAbility",
        "srcEntry": "./ets/entryability/QtScreenshotAbility.ets",
        "launchType": "singleton",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        // 截图宿主禁用系统启动页，避免首次初始化 Qt 时显示默认加载窗口。
        "startWindow": "$profile:screenshot_start_window",
        "startWindowIcon": "$media:screenshot_start_icon",
        "startWindowBackground": "$color:screenshot_start_background",
        "exported": false
      },
      {
        "name": "QtWorkspaceAbility",
        "srcEntry": "./ets/entryability/QtWorkspaceAbility.ets",
        "launchType": "singleton",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false
      },
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "launchType": "singleton",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}
